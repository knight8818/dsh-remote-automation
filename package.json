{
  "name": "dsh-remote-automation",
  "version": "0.2.0",
  "description": "Run scheduled automation on a remote Aliyun ECS from DeepSeek Harness: zero-inbound Cloud Assistant execution, a dedicated cloud-tasks sidebar page, and automation_* agent tools.",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "AGENTS.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "automation",
    "cron",
    "remote",
    "cloud",
    "aliyun",
    "ecs",
    "cloud-assistant"
  ],
  "license": "MIT",
  "author": "dsh-remote-automation contributors",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-0"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/host.js && node --check lib/client.js && node --check lib/aliyun.js && node --check lib/tasks.js && node --check lib/config.js && node --check lib/validate.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "yaml": "^2.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knight8818/dsh-remote-automation.git"
  },
  "homepage": "https://github.com/knight8818/dsh-remote-automation#readme",
  "bugs": {
    "url": "https://github.com/knight8818/dsh-remote-automation/issues"
  }
}
