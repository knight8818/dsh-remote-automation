{
  "name": "dsh-remote-automation",
  "version": "0.3.0",
  "description": "A DeepSeek Harness (DSH) plugin that runs scheduled shell automation on remote Aliyun ECS, Tencent Cloud CVM or AWS EC2 instances through zero-inbound command channels, with a Cloud Tasks sidebar page and agent tools.",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "AGENTS.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "automation",
    "cron",
    "remote",
    "cloud",
    "cloud-tasks",
    "scheduled-tasks",
    "aliyun",
    "aliyun-ecs",
    "ecs",
    "cloud-assistant",
    "tencent",
    "tencent-cloud",
    "cvm",
    "tat",
    "aws",
    "aws-ec2",
    "ssm",
    "multi-cloud"
  ],
  "license": "MIT",
  "author": "dsh-remote-automation contributors",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-0"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/host.js && node --check lib/client.js && node --check lib/aliyun.js && node --check lib/tencent.js && node --check lib/aws.js && node --check lib/clients.js && node --check lib/providers.js && node --check lib/tasks.js && node --check lib/config.js && node --check lib/validate.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "yaml": "^2.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knight8818/dsh-remote-automation.git"
  },
  "homepage": "https://github.com/knight8818/dsh-remote-automation#readme",
  "bugs": {
    "url": "https://github.com/knight8818/dsh-remote-automation/issues"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.1161.0",
    "tencentcloud-sdk-nodejs-tat": "^4.1.241"
  }
}
